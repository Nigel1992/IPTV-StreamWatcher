[Unit]
Description=StreamWatcher IPTV monitor (user-level)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/streamwatcher
Environment=IPTV_PORT=9001
ExecStart=%h/streamwatcher/.venv/bin/python %h/streamwatcher/run_local_test.py --no-browser
Restart=on-failure

[Install]
WantedBy=default.target
